# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth, profile, and decision persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sign-in methods (Auth UX Hardening milestone) ---------------------
#
# Google sign-in ("Continuar com Google", the primary sign-in action) uses
# Supabase's own "Google" OAuth provider - configured entirely in the
# Supabase dashboard (Authentication > Providers > Google), NOT via any env
# var in this file. There is nothing to set here for it to work; it just
# needs that dashboard provider enabled with its own Google Cloud OAuth
# Client ID/secret (redirect URI on the Google Cloud side must be Supabase's
# fixed callback: https://<project-ref>.supabase.co/auth/v1/callback).
# This is completely separate from GOOGLE_CLIENT_ID/SECRET below, which is
# for the app's own Google *Calendar data* integration, not identity.
#
# Microsoft sign-in ("Continuar com Microsoft") is feature-flagged off by
# default - the button is not rendered at all unless this is "true", and
# even then it also requires the Supabase dashboard's "Azure" provider to
# be configured (Authentication > Providers > Azure), with its own Entra ID
# (Azure AD) App Registration: redirect URI must be Supabase's fixed
# callback (same shape as Google's above), and the requested scopes should
# be "openid email profile" (identity only - this is NOT the read-only
# Outlook Calendar integration in feature/unified-calendar-intelligence,
# which is a fully separate MICROSOFT_CLIENT_ID/SECRET/TENANT_ID/
# REDIRECT_URI set used only for Graph Calendars.Read, never for sign-in).
# Leave this "false" until the Supabase-side provider is actually
# configured - never flip it on first, or the button will fail on click.
AUTH_MICROSOFT_ENABLED=false

# Google Calendar OAuth (required for Milestone 3 — Google Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Encrypts calendar_connections tokens at rest — generate a random 32+ char string
TOKEN_ENCRYPTION_KEY=

# AI provider (Decision Coach today; decision-engine AI refinement in a later milestone)
AI_PROVIDER=anthropic
AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: secret for any future scheduled/cron regeneration route
CRON_SECRET=
# Optional: enables the end-to-end checks that exercise real Supabase
# email/OTP delivery and admin-generated OTP codes. Keep disabled for the
# deterministic default suite.
PLAYWRIGHT_LIVE_EMAIL=0
