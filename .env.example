# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth, profile, and decision persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth (required for Milestone 3 — Google Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Microsoft 365 / Outlook Calendar OAuth — read-only (Calendars.Read, not
# Calendars.ReadWrite). Absence of these must never break Google Calendar or
# the rest of the app; every code path checks isMicrosoftCalendarConfigured()
# first (see lib/microsoft/oauth.ts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/microsoft/callback

# Encrypts calendar_connections tokens at rest — generate a random 32+ char string
TOKEN_ENCRYPTION_KEY=

# AI provider (Decision Coach today; decision-engine AI refinement in a later milestone)
AI_PROVIDER=anthropic
AI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: secret for any future scheduled/cron regeneration route
CRON_SECRET=
# Optional: enables the two end-to-end checks that send real Supabase
# passwordless emails. Keep disabled for the deterministic default suite.
PLAYWRIGHT_LIVE_EMAIL=0
